# ==============================================================================
# Website Authenticity Detector - Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Threat Intelligence API Keys (Optional - gracefully falls back if unset)
# Google Safe Browsing Lookup API v4 Key
SAFE_BROWSING_API_KEY=

# VirusTotal API v3 Key
VIRUSTOTAL_API_KEY=

# CORS Configuration (Optional - comma-separated origins, or leave empty / "*" for public web access)
# Example: https://my-fake-website-detector.com,https://app.my-fake-website-detector.com
CORS_ORIGINS=

# Container Sandbox Identifier (Used internally when running inside Docker containers)
SANDBOX_CONTAINER_ID=
